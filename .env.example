# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_GENERATIVE_AI_API_KEY=xxxxx
TAVILY_API_KEY=xxxxx

# Auth — magic link via Resend (https://resend.com)
AUTH_SECRET=xxxxx          # generate: openssl rand -base64 32
AUTH_RESEND_KEY=re_xxxxx   # Resend API key

# Database — Neon PostgreSQL (https://neon.tech)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require